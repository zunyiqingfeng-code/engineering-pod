# Copy to .env and fill in. Never commit a filled-in .env.

# Bearer token guarding the API. REQUIRED — the server fails closed without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POD_TOKEN=

# Where the sqlite db, task workspaces and artifacts live.
POD_BASE=./pod-data

# Timezone for cron schedules (IANA name, e.g. Europe/Berlin).
POD_TZ=UTC

# Default backend id (must exist in app/backends.py BACKENDS).
POD_DEFAULT_BACKEND=primary

# Backend CLI commands. Each is a coding-agent CLI that reads a prompt on stdin
# and works in the task's cwd. Point these at your own engine binaries.
POD_PRIMARY_CMD=codex-primary
POD_DEEPSEEK_CMD=codex-deepseek
# Leave the custom slot empty to disable it, or wire your own line here.
POD_CUSTOM_CMD=

# Names the delivery gate must never let leak into a deliverable (comma-separated).
# e.g. POD_BLOCKED_NAMES=Jane Doe,J. Doe
POD_BLOCKED_NAMES=
